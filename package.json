{
  "name": "motherbase",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, event-driven integration and automation platform.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "format": "prettier --write \"**/*.ts\" \"**/*.json\" \"**/*.md\" \"**/*.yaml\"",
    "format:check": "prettier --check \"**/*.ts\" \"**/*.json\" \"**/*.md\" \"**/*.yaml\"",
    "spell": "cspell \"**\""
  },
  "devDependencies": {
    "cspell": "^10.4.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
