// Editor's tsconfig, includes src and tests, but it's not used to build, so it does not have rootDir or outDir.
{
  "extends": "@motherbase/config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src", "test"]
}
